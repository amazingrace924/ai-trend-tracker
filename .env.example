# Artificial Analysis 무료 API 키 (https://artificialanalysis.ai → Insights → API key)
# 없으면 build-data가 라이브 수집을 건너뛰고 기존 fixture를 유지한다.
AA_API_KEY=

# (선택) 엔드포인트 오버라이드 — 키 발급 후 api-reference로 검증한 값으로 조정
# AA_API_BASE=https://artificialanalysis.ai/api/v2

# (선택) LMArena 커뮤니티 Elo JSON 엔드포인트
# ARENA_URL=https://api.wulong.dev/arena-ai-leaderboards/v1/leaderboard?name=text

# (선택) GitHub Pages 하위 경로 배포 시 리포지토리 이름 (예: /ai-trend-tracker)
# BASE_PATH=
